# NetPulse AI backend configuration
# Copy to .env and replace every placeholder before starting the application.

APP_NAME=NetPulse AI
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Local zero-setup demo database (used if DATABASE_URL is omitted):
DATABASE_URL=sqlite:///./data/netpulse.db
# Managed PostgreSQL for serverless/Vercel deployments (prefer the pooled URL):
# DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# Production MySQL example (uncomment, then comment the SQLite URL):
# DATABASE_URL=mysql+pymysql://netpulse:CHANGE_ME@127.0.0.1:3306/netpulse_ai?charset=utf8mb4

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap administrator. Created once, only when the users table is empty.
# Change both values before the first launch.
ADMIN_EMAIL=admin@netpulse.ai
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_FULL_NAME=NetPulse Administrator

# ---------------------------------------------------------------
# Monitoring (live measurements only; no fake values are generated)
# ---------------------------------------------------------------
# Cloudflare's anycast DNS service is the default reachability target.
MONITOR_TARGET=1.1.1.1
MONITOR_PACKET_COUNT=4
MONITOR_TIMEOUT_MS=1500
MONITORING_INTERVAL_SECONDS=60
MONITORING_ENABLED=true
MONITOR_ON_STARTUP=true
# Read-only discovery from the operating system's local ARP cache.
DEVICE_DISCOVERY_ENABLED=true

# ---------------------------------------------------------------
# Unified host, agent and network telemetry
# ---------------------------------------------------------------
# Real psutil collection on the backend host (never estimated values).
HOST_MONITORING_ENABLED=true
HOST_METRIC_INTERVAL_SECONDS=60
HOST_OFFLINE_AFTER_SECONDS=180
HOST_METRIC_RETENTION_DAYS=7
CPU_THRESHOLD_PCT=90
MEMORY_THRESHOLD_PCT=90
DISK_THRESHOLD_PCT=90
# Authenticated remote agents post telemetry at most this often.
AGENT_TELEMETRY_RATE_LIMIT_PER_MINUTE=120
# Real DNS and TCP connectivity checks run by the scheduler.
NETWORK_DNS_TARGET=cloudflare.com
NETWORK_TCP_TARGETS=1.1.1.1:443,8.8.8.8:53
NETWORK_CHECK_INTERVAL_SECONDS=60

# ---------------------------------------------------------------
# Optional threat-intelligence enrichment (server-side only)
# ---------------------------------------------------------------
# Disabled by default. The API key is never returned to the browser.
THREAT_INTEL_ENABLED=false
THREAT_INTEL_PROVIDER=abuseipdb
ABUSEIPDB_API_KEY=
THREAT_INTEL_CACHE_MINUTES=1440
THREAT_INTEL_MAX_LOOKUPS_PER_SCAN=5

# ---------------------------------------------------------------
# Automatic tickets / anomaly detection
# ---------------------------------------------------------------
LATENCY_THRESHOLD_MS=150
PACKET_LOSS_THRESHOLD_PCT=5
AUTO_TICKETS_ENABLED=true
AUTO_ANOMALY_DETECTION=true
ANOMALY_MIN_SAMPLES=30
ANOMALY_CONTAMINATION=0.08

# ---------------------------------------------------------------
# Test runner / reports
# ---------------------------------------------------------------
# Fixed, allow-listed pytest command. Never accepts arbitrary shell input.
TEST_RUNNER_ENABLED=true
REPORTS_DIR=../reports
